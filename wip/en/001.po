msgstr ""

msgctxt "a588f9a8f74643de954e280224017c06"
msgid "མཐའ་ སྡུད་ སྨོན་ལམ་ ཟབ་མོ་ འདི་␣༔"
msgstr ""

msgctxt "e106d30e65dd4f019d7806777fd13a00"
msgid "བཀའ་སྲུང་ དྲང་སྲོང་ རྭ་ ཧུ་ ལ་␣༔"
msgstr ""

msgctxt "0620f477f2504c7f87d0b70d770a0ccf"
msgid "བནྡྷེའི་ ཚུལ་ གྱིས་ བསྐུལ་ ནས་ བཀོད་␣༔"
msgstr ""

msgctxt "7e34cf0ac2d24b32946bda8cc9d8bd74"
msgid "ཟབ་ དོན་ སྤེལ་བ་ དོན་ ཡིད་ ཅིང༌་␣༔"
msgstr ""

msgctxt "ca2b6ba3e6654be7b443fb51ae2b145a"
msgid "རྟེན་འབྲེལ་ སྨོན་ལམ་ མཐ་␣ར་ ཕྱིན་ ཕྱིར་␣༔"
msgstr ""

msgctxt "b0f3a2329f4c415a9b1a9b0461308b16"
msgid "ནམ་མཁ་␣འི་ སྙིང་པོ་␣ས་ བྱིན་རླབས་པ་␣འི་␣༔"
msgstr ""

msgctxt "9102138fed424d78810ff4c1fac5f246"
msgid "ཀོང་ སྨྱོན་ སྦས་པ་␣འི་ རིག་འཛིན་ ལ་␣༔"
msgstr ""

msgctxt "8f532b2427d34319b8e733f2781f0e4b"
msgid "ཟབ་ རྒྱ་ བཀྲོལ་ ཏེ་ གཏད་རྒྱ་ བྱས་␣༔"
msgstr ""

msgctxt "e74c62c70f034e9d95bea154c6e200bc"
msgid "འགྲོ་དོན་ ནམ་མཁའ་ མཉམ་པ་␣ར་ ཤོག་␣༔ ༔"
msgstr ""
